# ============================================================
# 本地开发配置文件模板
# 使用方式：复制为 application-local.yml 并填入你的真实配置
#   cp application-local.yml.example application-local.yml
# ============================================================

spring:
  ai:
    dashscope:
      api-key: <你的 DashScope API Key>
      chat:
        options:
          model: deepseek-v3.2
      image:
        enabled: true
        options:
          model: wanx-v1
    # 注意：向量存储由 TourAppVectorStoreConfig 手动构建（非 Spring 自动配置），
    # 维度跟随 DashScope embedding 模型实际输出（PgVectorStore 默认调 embeddingModel.dimensions()）。
    # 此处 spring.ai.vectorstore.pgvector.* 为自动配置属性，对手动 Bean 不生效，保留仅作参考。
    vectorstore:
      pgvector:
        initialize-schema: true
        index-type: HNSW
        distance-type: COSINE_DISTANCE
        max-document-batch-size: 10
        schema-name: public

  # PostgreSQL — 唯一数据源（对话记忆 + pgvector 共用）
  datasource:
    driver-class-name: org.postgresql.Driver
    url: jdbc:postgresql://localhost:5432/sora_agent
    username: <你的 PostgreSQL 用户名>
    password: <你的 PostgreSQL 密码>

# Exa 联网搜索（可选；不填则搜索工具不注册，应用照常启动）
exa:
  api-key: <你的 Exa API Key>

# 可随意添加模型（仅限阿里云百炼平台）
app:
  security:
    # API Key 认证开关。默认开启；仅完全可信的内网环境才可显式设为 false
    enabled: true
    # 有效 API Key（至少一个；enabled=true 且为空时应用拒绝启动，避免裸奔）
    api-keys:
      - <你的 API Key，至少一个>
    # 需要认证保护的请求路径（Ant 模式，相对 /api context-path）；静态资源/文档与 /image/**（图片代理，受信中继）默认不在其中
    protect-patterns:
      - /ai/**
      - /chat/**
    # 跨域来源白名单（前端部署地址；认证走请求头，不再依赖 Cookie）
    cors:
      allowed-origins:
        - http://localhost:5173
        - http://127.0.0.1:5173
    # 危险工具开关：默认全部关闭（关闭=不注册，模型不可见）。本地开发按需开启
    tools:
      file-read: false     # 文件读取（潜在信息泄露）
      file-write: false    # 文件写入（潜在覆盖/写马）
      download: false      # 资源下载（SSRF + 写盘）
      scrape: false        # 网页抓取（SSRF 读取）
      terminal:
        enabled: false     # 终端命令执行（任意命令，最高风险）
        allow-commands: [] # 可选命令前缀白名单；空=放行（开启工具者的责任）
        timeout-seconds: 30
        max-output-bytes: 204800
    # 每 key 滑动窗口限流（防持 key 者刷爆付费 LLM 账单）
    rate-limit:
      enabled: true
      per-key-per-minute: 60
    # 是否把 MCP 工具合并进 agent（默认关）。MCP 工具不经 app.security.tools.* 开关过滤，属外部能力
    enable-mcp-tools: false
    # 图片代理受信中继：仅代理白名单内的图片域名（DashScope/OSS）
    image-proxy:
      allowed-hosts:
        - dashscope-result-bj.oss-cn-beijing.aliyuncs.com
        - '*.oss-cn-beijing.aliyuncs.com'
  # 图片代理基础地址（部署时改为实际域名/端口，替代硬编码 localhost:8080）
  image:
    base-url: http://localhost:8080
  # 技能体系（声明式能力包）：把 skill YAML 放进目录即可用（重启后生效）
  skill:
    enabled: true
    # 额外技能目录（文件系统路径，可选）；留空则只加载 classpath 内置技能 src/main/resources/skills/
    # dir: ./skills
  # 工作流体系（声明式步骤编排）：把 workflow YAML 放进目录即可用（重启后生效）
  workflow:
    enabled: true
    step-timeout-seconds: 120   # 单步超时，防止挂起工具无限阻塞
    # 额外工作流目录（文件系统路径，可选）；留空则只加载 classpath 内置工作流 src/main/resources/workflows/
    # dir: ./workflows
  # 多 Agent 专家体系（声明式）：把 agent YAML 放进目录即可用（重启后生效）
  agent:
    enabled: true
    max-concurrency: 4
    delegation-timeout-seconds: 120  # 单次委派总超时，防止 worker 挂起拖死 supervisor
  # 执行器：agent/工作流跑在虚拟线程上（I/O 密集近乎无上限并发），真实 LLM 并发由信号量限制
  executor:
    llm-max-concurrency: 16   # 全局最大并发 LLM 调用数（防打爆 DashScope 额度）
    # 额外专家目录（文件系统路径，可选）；留空则只加载 classpath 内置专家 src/main/resources/agents/
    # dir: ./agents
  # 会话记忆（Manus 智能体跨请求记忆 + 「对话记录」）
  memory:
    namespace: manus          # 会话命名空间（与其它 agent 类型隔离）
    window-size: 20           # 上下文保留最近消息条数，超出则压缩为摘要
    summarize-overflow: true  # 超窗是否生成摘要（关闭则直接丢弃超窗部分）
    summarize-input-limit: 8000
    title-max-length: 30      # 会话列表标题截断长度
  models:
    available:
      - name: deepseek-v3.2
        display: "DeepSeek V3.2"
      - name: qwen-turbo
        display: "Qwen Turbo"
      - name: qwen-plus
        display: "Qwen Plus"
      - name: deepseek-v3
        display: "Deepseek V3"
    default-model: deepseek-v3.2
